# 复制成 .env 再改：cp .env.example .env
# .env 已经在 .gitignore 里，不会被提交

# ---------- 对外端口 ----------
HTTP_PORT=80

# ---------- 数据库密码（务必改掉！） ----------
MYSQL_ROOT_PASSWORD=改成一个强密码
MYSQL_DATABASE=vue3_admin
MYSQL_USER=vue3_admin
MYSQL_PASSWORD=改成另一个强密码

# ---------- 仓库/构建相关 ----------
# 后端仓库的位置，相对于本 compose 文件所在目录
# 默认是"前端仓库的上一级目录里的 vue3_admin_backend"
BACKEND_CONTEXT=../../vue3_admin_backend
# 服务器在国内就用 npmmirror；海外服务器改成 https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com
